# ClickHouse Cloud
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Senso (docs.senso.ai)
SENSO_API_KEY=

# Anthropic (or TrueFoundry gateway base URL + key in P1)
ANTHROPIC_API_KEY=

# Alpha Vantage (PyAirbyte source-file CSV backfill)
ALPHAVANTAGE_API_KEY=

# Pioneer / Fastino headline classifier (optional demo fuse)
PIONEER_API_KEY=

# Pipeline
UNIVERSE=AAPL,MSFT,NVDA,AMD,TSLA,GOOGL,AMZN,META,PLTR,SOFI
MODE=live
CORS_ALLOWED_ORIGINS=https://thetadesk-agent.onrender.com,http://localhost:3000,http://127.0.0.1:3000
RUN_API_KEY=

# Render deploy polling (local ops only; never expose publicly)
RENDER_API_KEY=
